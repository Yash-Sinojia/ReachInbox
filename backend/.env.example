# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
# Local:      postgresql://postgres:postgres@localhost:5432/reachinbox
# Railway:    Provided automatically as DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis
# Local dev: use HOST + PORT
REDIS_HOST=localhost
REDIS_PORT=6379
# Production (Railway): use the full URL instead (overrides HOST/PORT)
# REDIS_URL=redis://default:password@host:port
# REDIS_PRIVATE_URL=redis://default:password@private-host:port  (faster, same Railway project)

# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session (use a long random string in production)
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Frontend URL (for CORS + OAuth redirect)
# Comma-separated list supported: "https://reachinbox.vercel.app,http://localhost:3000"
FRONTEND_URL=http://localhost:3000

# Elasticsearch
# Local:   http://localhost:9200
# Bonsai (free tier): https://user:pass@host.bonsaisearch.net
ELASTICSEARCH_URL=http://localhost:9200

# BullMQ Worker Config
WORKER_CONCURRENCY=5
# Minimum delay between email sends (ms)
MIN_SEND_DELAY_MS=2000
# Rate limiting
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Slack OAuth - https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:3001/slack/callback
