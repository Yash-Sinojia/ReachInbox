# =============================================================================
# ReachInbox — Root .gitignore
# Covers: backend (Express/Node), frontend (Next.js), infra, and AI agent files
# =============================================================================


# ─── Node / npm ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json


# ─── Environment variables ────────────────────────────────────────────────────
# Never commit real secrets
.env
.env.*
!.env.example


# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
dist/


# ─── Next.js (frontend) ───────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/.vercel


# ─── Backend build ────────────────────────────────────────────────────────────
backend/dist/


# ─── Testing / coverage ───────────────────────────────────────────────────────
coverage/


# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem


# ─── AI agent / IDE files ─────────────────────────────────────────────────────
AGENTS.md
CLAUDE.md
PROJECT_STATE.md
.agents/
.gemini/
