# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Frontend URL (for CORS + OAuth redirect)
FRONTEND_URL=http://localhost:3000

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# BullMQ Worker Config
WORKER_CONCURRENCY=5
# Minimum delay between email sends (ms)
MIN_SEND_DELAY_MS=2000
# Rate limiting: max emails per hour (global or per sender)
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:3001/slack/callback
